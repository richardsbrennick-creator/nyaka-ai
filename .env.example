# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Google OAuth (get from console.cloud.google.com - FREE)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Africa's Talking SMS (get from africastalking.com - FREE sandbox)
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=NYAKA

# Admin email for SGBV reports
ADMIN_EMAIL=admin@nyakaglobal.org
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password

# Database
DATABASE_URL=sqlite:///nyaka.db
